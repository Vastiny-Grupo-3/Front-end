        {
          "name": "5. Estrutura da resposta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test(\"Tem kpis, categorias, topProdutos e estoque\", () => [\"kpis\",\"categorias\",\"topProdutos\",\"estoque\"].forEach(c => pm.expect(corpo).to.have.property(c)));",
                  "pm.test(\"kpis completo\", () => [\"vendasNoPeriodo\",\"faturamento\",\"lucro\",\"precoMedio\"].forEach(c => pm.expect(corpo.kpis, c).to.have.property(c)));",
                  "pm.test(\"estoque completo\", () => [\"bom\",\"medio\",\"ruim\",\"critico\",\"precisamReposicao\"].forEach(c => pm.expect(corpo.estoque, c).to.have.property(c)));",
                  "pm.test(\"categorias: no máximo 6, ordenadas do maior faturado para o menor\", () => { pm.expect(corpo.categorias.length).to.be.at.most(6); for (let i = 1; i < corpo.categorias.length; i++) pm.expect(Number(corpo.categorias[i-1].faturado)).to.be.at.least(Number(corpo.categorias[i].faturado)); });",
                  "pm.test(\"topProdutos: no máximo 10, por quantidade vendida decrescente\", () => { pm.expect(corpo.topProdutos.length).to.be.at.most(10); for (let i = 1; i < corpo.topProdutos.length; i++) pm.expect(corpo.topProdutos[i-1].qtdVendida).to.be.at.least(corpo.topProdutos[i].qtdVendida); });",
                  "pm.test(\"topProdutos com os campos do contrato\", () => corpo.topProdutos.forEach(t => [\"codigo\",\"nome\",\"categoria\",\"qtdVendida\",\"faturado\",\"lucro\"].forEach(c => pm.expect(t, c).to.have.property(c))));",
                  "pm.test(\"Lucro nunca maior que o faturamento\", () => pm.expect(Number(corpo.kpis.lucro)).to.be.at.most(Number(corpo.kpis.faturamento)));"
                ]
              }
            }
          ],
