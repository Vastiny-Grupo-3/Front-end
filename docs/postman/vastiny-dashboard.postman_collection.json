    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "emailInicial",
      "value": "admin@vastiny.com"
    },
    {
      "key": "senhaInicial",
      "value": "Vastiny123"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
