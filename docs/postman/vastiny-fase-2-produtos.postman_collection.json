    {
      "name": "7. Valores e quantidade válidos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const corpo = pm.response.json();",
              "pm.test(\"quantidade é inteiro maior ou igual a 0 (nunca null)\", () => corpo.forEach(p => { pm.expect(Number.isInteger(p.quantidade), \"produto \" + p.id).to.be.true; pm.expect(p.quantidade).to.be.at.least(0); }));",
              "pm.test(\"Os 3 valores são números maiores ou iguais a 0\", () => corpo.forEach(p => [\"valorCompra\",\"precoEmpresa\",\"precoConsumidor\"].forEach(c => { pm.expect(p[c], c + \" do produto \" + p.id).to.be.a(\"number\"); pm.expect(p[c]).to.be.at.least(0); })));",
              "pm.test(\"Preço da empresa não é menor que a compra, e o do consumidor não é menor que o da empresa\", () => corpo.forEach(p => { pm.expect(p.precoEmpresa, \"empresa x compra no produto \" + p.id).to.be.at.least(p.valorCompra); pm.expect(p.precoConsumidor, \"consumidor x empresa no produto \" + p.id).to.be.at.least(p.precoEmpresa); }));"
            ]
          }
        }
