    {
      "name": "5. Cada produto tem os campos do contrato",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const corpo = pm.response.json();",
              "const campos = [\"id\",\"codigos\",\"descricao\",\"categoriaId\",\"imagem\",\"valorCompra\",\"precoEmpresa\",\"precoConsumidor\",\"quantidade\",\"faixaPropria\"];",
              "pm.test(\"Todos os campos existem em todos os produtos\", () => corpo.forEach(p => campos.forEach(c => pm.expect(p, \"produto \" + p.id + \" sem \" + c).to.have.property(c))));",
              "pm.test(\"id inteiro e descrição preenchida\", () => corpo.forEach(p => { pm.expect(Number.isInteger(p.id)).to.be.true; pm.expect(p.descricao).to.be.a(\"string\").and.not.empty; }));"
            ]
