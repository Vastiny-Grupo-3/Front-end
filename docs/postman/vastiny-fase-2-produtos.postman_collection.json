    {
      "name": "13. Contagem por nível confere com o dashboard",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const corpo = pm.response.json();",
              "const categorias = JSON.parse(pm.collectionVariables.get(\"categoriasJson\"));",
              "const produtos = JSON.parse(pm.collectionVariables.get(\"produtosJson\"));",
              "const faixa = id => categorias.find(c => c.id === id).criterios;",
              "const niveis = { bom: 0, medio: 0, ruim: 0, critico: 0 };",
              "produtos.forEach(p => { const f = faixa(p.categoriaId); const q = p.quantidade; if (q >= f.bom) niveis.bom++; else if (q >= f.medio) niveis.medio++; else if (q >= f.ruim) niveis.ruim++; else niveis.critico++; });",
              "pm.test(\"estoque.bom/medio/ruim/critico batem com o cálculo da lista de produtos\", () => { pm.expect(corpo.estoque.bom, \"bom\").to.eql(niveis.bom); pm.expect(corpo.estoque.medio, \"medio\").to.eql(niveis.medio); pm.expect(corpo.estoque.ruim, \"ruim\").to.eql(niveis.ruim); pm.expect(corpo.estoque.critico, \"critico\").to.eql(niveis.critico); });",
              "pm.test(\"precisamReposicao = ruim + critico\", () => pm.expect(corpo.estoque.precisamReposicao).to.eql(niveis.ruim + niveis.critico));"
            ]
          }
        }
      ],
