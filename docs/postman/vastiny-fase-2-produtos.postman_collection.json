    {
      "name": "6. codigos: de 1 a 4 itens, sem null nem vazio, sem repetir",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const corpo = pm.response.json();",
              "pm.test(\"1 a 4 códigos preenchidos\", () => corpo.forEach(p => { pm.expect(p.codigos, \"produto \" + p.id).to.be.an(\"array\"); pm.expect(p.codigos.length, \"produto \" + p.id).to.be.within(1, 4); p.codigos.forEach(c => pm.expect(c, \"código vazio/nulo no produto \" + p.id).to.be.a(\"string\").and.not.match(/^\\s*$/)); }));",
              "pm.test(\"Sem código repetido dentro do produto\", () => corpo.forEach(p => pm.expect(new Set(p.codigos).size, \"produto \" + p.id).to.eql(p.codigos.length)));",
              "pm.test(\"Nenhum código repetido entre produtos diferentes\", () => { const vistos = {}; corpo.forEach(p => p.codigos.forEach(c => { pm.expect(vistos[c], \"código \" + c + \" no produto \" + p.id + \" e no \" + vistos[c]).to.be.undefined; vistos[c] = p.id; })); });"
            ]
          }
        }
