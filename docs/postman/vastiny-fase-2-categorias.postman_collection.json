    {
      "name": "2. Criar categoria válida → 201 (faixas na ordem certa)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"nomeCategoria\", \"Lâmpadas \" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const corpo = pm.response.json();",
              "pm.test(\"id e nome\", () => { pm.expect(corpo.id).to.exist; pm.expect(corpo.nome).to.eql(pm.collectionVariables.get(\"nomeCategoria\")); });",
              "pm.test(\"Faixas gravadas na ordem certa\", () => pm.expect(corpo.criterios).to.eql({ bom: 15, medio: 10, ruim: 5, critico: 0 }));",
              "pm.collectionVariables.set(\"categoriaId\", corpo.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/categorias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categorias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{nomeCategoria}}\",\n  \"criterios\": {\n    \"bom\": 15,\n    \"medio\": 10,\n    \"ruim\": 5,\n    \"critico\": 0\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
