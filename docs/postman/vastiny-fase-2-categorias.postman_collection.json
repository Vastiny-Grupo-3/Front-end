{
  "info": {
    "name": "Vastiny — Back-end, testes da Fase 2 (Categorias)",
    "description": "Rode a coleção em ordem (Runner). Precisa da conta inicial (emailInicial e senhaInicial). O teste 23 é opcional: para rodá-lo, crie um produto no banco em uma categoria e preencha categoriaComProdutoId nas variáveis; sem isso ele é pulado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "emailInicial",
      "value": "admin@vastiny.com"
    },
    {
      "key": "senhaInicial",
      "value": "troque-esta-senha1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "categoriaIguaisId",
      "value": ""
    },
    {
      "key": "categoriaComProdutoId",
      "value": ""
    },
    {
      "key": "nomeCategoria",
      "value": ""
    },
    {
      "key": "nomeIguais",
      "value": ""
    },
    {
      "key": "nomeMaiusculo",
      "value": ""
    },
    {
      "key": "nomeComEspacos",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Login da conta inicial → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const corpo = pm.response.json();",
              "pm.collectionVariables.set(\"token\", corpo.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailInicial}}\",\n  \"senha\": \"{{senhaInicial}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "1. GET /categorias SEM token → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
